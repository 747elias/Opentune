[Desktop Entry]
Type=Application
Name=OpenTune
Comment=A music player for YouTube Music
Exec=opentune %F
Icon=opentune
Terminal=false
Categories=AudioVideo;Audio;Player;
MimeType=audio/mpeg;audio/flac;audio/ogg;audio/opus;audio/mp4;audio/x-wav;audio/aac;audio/webm;
StartupWMClass=com-opentune-desktop-MainKt
